{
  "mode": "unified",
  "seed": 42,
  "deterministic": false,
  "sensor_hz": 100,
  "history_steps": 100,
  "history_duration_s": 1.0,
  "input_channel_names": [
    "left_thigh_angle_rad",
    "left_thigh_angular_velocity_rad_s",
    "right_thigh_angle_rad",
    "right_thigh_angular_velocity_rad_s"
  ],
  "target_channel_names": [
    "left_teacher_action_norm",
    "right_teacher_action_norm"
  ],
  "input_channels": 4,
  "hidden_channels": 32,
  "output_channels": 2,
  "kernel_size": 4,
  "dilations": [1, 2, 4, 8],
  "dropout": 0.1,
  "activation": "silu",
  "batch_size": 256,
  "num_workers": 4,
  "pin_memory": true,
  "persistent_workers": true,
  "normalize": true,
  "unified_balance": true,
  "unified_normalization": "regime_balanced",
  "dataset_root": "tcn/data_generation_v2/output/unified_100hz_5500",
  "optimizer": "adamw",
  "learning_rate": 0.001,
  "weight_decay": 0.0001,
  "max_grad_norm": 1.0,
  "scheduler": "reduce_on_plateau",
  "scheduler_factor": 0.5,
  "scheduler_patience": 3,
  "min_learning_rate": 0.000001,
  "max_epochs": 100,
  "early_stopping_patience": 10,
  "loss": "mse",
  "checkpoint_metric": "val_mse",
  "torque_scale_nm": 12.0,
  "amp": true,
  "show_progress": true,
  "progress_interval_batches": 50,
  "eta_ema_alpha": 0.1,
  "device": "auto",
  "results_dir": "tcn/results"
}
